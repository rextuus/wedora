# Vorlage für .env.docker.local (nicht versioniert). Mit `make secrets` automatisch befüllen.
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
IMGPROXY_KEY=
IMGPROXY_SALT=
MEDIA_TOKEN_SECRET=
WEB_PORT=8180
# Produktion: Domain eintragen (z. B. wedora.example.org) → Caddy holt automatisch ein TLS-Zertifikat.
SERVER_NAME=:80
