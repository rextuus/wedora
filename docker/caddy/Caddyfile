# Wedora – Caddy vor PHP-FPM.
# Lokal und in Produktion nur HTTP (SERVER_NAME=":80"): HTTPS macht live der Caddy auf dem VPS, der über
# WireGuard hierher weiterleitet (docs/deployment.md).
{
	admin off
	servers {
		# Von diesen Adressen (dem Reverse-Proxy) werden X-Forwarded-For/-Proto übernommen: echte Gast-IP
		# und „kam per HTTPS“. Von allen anderen setzt Caddy die Werte selbst (nicht fälschbar).
		trusted_proxies static {$REVERSE_PROXY_IPS:private_ranges}
		client_ip_headers X-Forwarded-For
	}
}

{$SERVER_NAME::80} {
	root * /srv/app/public
	encode zstd gzip

	# Uploads kommen in Stücken zu je 8 MiB; größere Anfragen werden gar nicht erst angenommen.
	request_body {
		max_size 9MB
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# Interne Pfade dürfen von außen nie erreichbar sein.
	@internal path /_protected/* /index.php/_protected/*
	respond @internal 404

	php_fastcgi app:9000 {
		# Symfony hat die Berechtigung geprüft und verweist per X-Accel-Redirect auf die Datei.
		@accel header X-Accel-Redirect *
		handle_response @accel {
			rewrite * {rp.header.X-Accel-Redirect}

			route {
				# Wie von Symfony vorgegeben: nur im Browser des Betrachters, solange die URL gilt.
				header Cache-Control {rp.header.Cache-Control}

				handle_path /_protected/files/* {
					root * /srv/media
					file_server
				}

				handle_path /_protected/imgproxy/* {
					reverse_proxy imgproxy:8080 {
						header_down -Server
					}
				}

				respond 404
			}
		}
	}

	file_server
}
