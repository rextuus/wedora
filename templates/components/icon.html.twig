{# Schlanke Linien-Icons (Stil angelehnt an Material Symbols Outlined), eingebettet statt Icon-Schrift. #}
{% macro icon(name, size = 22, label = null) %}
    {%- set paths = {
        camera: '<path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/>',
        photos: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="m3 16 5-5 4 4 3-3 6 6"/><circle cx="16" cy="8" r="1.5"/>',
        flag: '<path d="M5 21V4m0 0h11l-2 4 2 4H5"/>',
        share: '<path d="M12 15V3m0 0L8 7m4-4 4 4"/><path d="M7 10H5v11h14V10h-2"/>',
        close: '<path d="M6 6l12 12M18 6 6 18"/>',
        shoe: '<path d="M3 16c0-1.7 1.2-3 2.8-3H9l3.2-3.1a1.3 1.3 0 0 1 2.1.4l.9 1.9a2.6 2.6 0 0 0 2.3 1.5H19a2 2 0 0 1 2 2v1.3H3z"/><path d="M3 18.5h18"/>',
        sparkle: '<path d="M11 4q1.2 6.8 8 8-6.8 1.2-8 8-1.2-6.8-8-8 6.8-1.2 8-8z"/><path d="M19 2.5q.4 1.9 2.3 2.3-1.9.4-2.3 2.3-.4-1.9-2.3-2.3 1.9-.4 2.3-2.3z"/>',
        book: '<path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2z"/><path d="M4 19V5"/><path d="M9 7h6"/>',
        album: '<path d="M6 3h12v18l-6-4-6 4z"/>',
        heart: '<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>',
        heart_filled: '<path fill="currentColor" d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>',
        play: '<path fill="currentColor" stroke="none" d="M9 7v10l8-5z"/>',
        lock: '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>',
        check: '<path d="m5 12 4 4 10-10"/>',
        upload: '<path d="M12 16V4m0 0-4 4m4-4 4 4"/><path d="M4 16v4h16v-4"/>',
        trash: '<path d="M4 7h16M9 7V4h6v3m-8 0 1 13h8l1-13"/>',
        report: '<path d="M12 4 3 20h18z"/><path d="M12 10v4m0 3v.5"/>',
        back: '<path d="M15 5 8 12l7 7"/>',
        next: '<path d="m9 5 7 7-7 7"/>',
        home: '<path d="M4 11 12 4l8 7v9h-5v-6H9v6H4z"/>',
        clock: '<circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/>',
        users: '<circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0"/><path d="M16 5a3 3 0 0 1 0 6m2 9a6 6 0 0 0-3-5.2"/>',
        settings: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3m0 14v3M2 12h3m14 0h3M4.9 4.9l2.1 2.1m10 10 2.1 2.1M4.9 19.1 7 17m10-10 2.1-2.1"/>',
        shield: '<path d="M12 3 5 6v6c0 4 3 7.5 7 9 4-1.5 7-5 7-9V6z"/>',
        key: '<circle cx="8" cy="15" r="4"/><path d="m11 12 9-9m-4 4 3 3"/>',
        download: '<path d="M12 4v12m0 0-4-4m4 4 4-4"/><path d="M4 18v2h16v-2"/>',
    } -%}
    <svg class="icon" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"{% if label %} role="img" aria-label="{{ label }}"{% else %} aria-hidden="true" focusable="false"{% endif %}>{{ (paths[name] ?? '')|raw }}</svg>
{%- endmacro %}
