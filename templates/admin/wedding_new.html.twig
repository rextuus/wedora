{% extends 'admin/_layout.html.twig' %}

{% block content %}
    <h1 class="headline-lg">Neue Hochzeit</h1>
    {% if error %}<p class="notice notice--error" role="alert">{{ error }}</p>{% endif %}
    <form method="post" class="card stack">
        {{ include('admin/_csrf.html.twig') }}
        <div class="field"><label for="title">Name</label><input id="title" name="title" maxlength="120" placeholder="Anna & Lukas" required value="{{ app.request.request.get('title') }}"></div>
        <div class="field"><label for="slug">Kürzel für den Link</label><input id="slug" name="slug" pattern="[a-z0-9][a-z0-9-]{1,62}[a-z0-9]" placeholder="anna-und-lukas" required value="{{ app.request.request.get('slug') }}"><p class="help">Kleinbuchstaben, Ziffern und Bindestriche; erscheint in der Adresse /h/kürzel.</p></div>
        <div class="field"><label for="date">Datum (optional)</label><input id="date" name="date" type="date"></div>
        <button class="button button--primary" type="submit">Anlegen</button>
    </form>
{% endblock %}
