{% extends 'admin/_layout.html.twig' %}

{% block content %}
    <section class="card" aria-labelledby="general-title">
        <h2 id="general-title" class="headline-sm">Allgemein</h2>
        <form method="post" action="{{ path('admin_settings_general', {slug: wedding.slug}) }}" class="stack">
            {{ include('admin/_csrf.html.twig') }}
            <div class="field"><label for="title">Name (wie Gäste ihn sehen)</label><input id="title" name="title" value="{{ wedding.title }}" maxlength="120" required></div>
            <div class="field"><label for="date">Datum</label><input id="date" name="date" type="date" value="{{ wedding.weddingDate ? wedding.weddingDate|date('Y-m-d') : '' }}"></div>
            <fieldset class="choice-group choice-group--stacked">
                <legend>Neue Beiträge</legend>
                {% for mode in modes %}
                    <label class="choice"><input type="radio" name="moderation" value="{{ mode.value }}"{% if wedding.moderationMode == mode %} checked{% endif %}>
                        {{ {'immediate': 'Sofort veröffentlichen', 'approval': 'Erst nach Freigabe sichtbar', 'post_moderation': 'Sofort veröffentlichen, nachträglich prüfen'}[mode.value] }}</label>
                {% endfor %}
            </fieldset>
            <button class="button button--primary" type="submit">Speichern</button>
        </form>
    </section>

    <section class="card" aria-labelledby="modules-title">
        <h2 id="modules-title" class="headline-sm">Module</h2>
        <form method="post" action="{{ path('admin_settings_modules', {slug: wedding.slug}) }}" class="stack">
            {{ include('admin/_csrf.html.twig') }}
            {% for type in modules %}
                {% set module = wedding.module(type) %}
                <fieldset class="module-row">
                    <legend class="visually-hidden">{{ {'gallery': 'Galerie', 'guestbook': 'Gästebuch', 'challenges': 'Aufgaben'}[type.value] }}</legend>
                    <label class="toggle"><input type="checkbox" name="enabled_{{ type.value }}"{% if module.enabled %} checked{% endif %}> <strong>{{ {'gallery': 'Galerie', 'guestbook': 'Gästebuch', 'challenges': 'Aufgaben'}[type.value] }}</strong></label>
                    <div class="field">
                        <label for="close_{{ type.value }}">Beiträge möglich bis (optional)</label>
                        <input id="close_{{ type.value }}" type="datetime-local" name="close_{{ type.value }}" value="{{ module.contributionsCloseAt ? module.contributionsCloseAt|date('Y-m-d\\TH:i') : '' }}">
                    </div>
                </fieldset>
            {% endfor %}
            <label class="toggle"><input type="checkbox" name="points"{% if wedding.areChallengePointsEnabled() %} checked{% endif %}> Punkte und Rangliste für Aufgaben anzeigen</label>
            <label class="toggle"><input type="checkbox" name="portraits"{% if wedding.arePortraitsEnabled() %} checked{% endif %}> Gezeichnete Porträts: Gäste können aus einem Selfie eine Linienzeichnung erstellen lassen</label>
            <p class="notice">Kostenbremse (alle Hochzeiten zusammen): heute <strong>{{ aiUsage.today }} von {{ aiUsage.dailyLimit }}</strong>, diesen Monat <strong>{{ aiUsage.month }} von {{ aiUsage.monthlyLimit }}</strong> Zeichnungen. Ist eine Grenze erreicht, geht nichts mehr an Gemini. Die Grenzen stellt die Plattformadministration unter „Alle Hochzeiten“ ein.</p>
            <label class="toggle"><input type="checkbox" name="portrait_gadgets"{% if wedding.arePortraitGadgetsEnabled() %} checked{% endif %}> Überraschungs-Accessoire mitzeichnen (Krone, Federboa, Taube, Herz-Tattoo …)</label>
            <details class="gadget-key">
                <summary>So entsteht das Accessoire (Auflösung – nicht für Gäste)</summary>
                <p><a class="text-link" href="{{ path('admin_portrait_prompt', {slug: wedding.slug}) }}">Porträt-Prompt testen – exakter Text für Gemini zum Kopieren ›</a></p>
                <p class="muted">Beim Selfie kommt zufällig eine dieser Fragen. Die Antwort bestimmt das Accessoire fest; den Gästen wird das nicht verraten, sie sehen nur „Überraschung: mit …“. Brillen gibt es bewusst nicht – viele tragen schon eine.</p>
                {% for question in portraitQuestions %}
                    <table class="gadget-key__table">
                        <caption>„{{ question.question }}“</caption>
                        {% for answer in question.answers %}
                            <tr><th scope="row">{{ answer.label }}</th><td>{{ answer.gadget.label }}</td></tr>
                        {% endfor %}
                    </table>
                {% endfor %}
            </details>
            <fieldset class="choice-group">
                <legend>Wer bestimmt den Stil?</legend>
                {% for mode in portraitStyleModes %}
                    <label class="choice"><input type="radio" name="portrait_style_mode" value="{{ mode.value }}"{% if wedding.portraitStyleMode == mode %} checked{% endif %}> {{ mode.label }}</label>
                {% endfor %}
            </fieldset>
            <fieldset class="choice-group">
                <legend>Angebotene Zeichenstile</legend>
                {% for style in portraitStyles %}
                    <label class="choice"><input type="checkbox" name="portrait_styles[]" value="{{ style.value }}"{% if style in wedding.portraitStyles() %} checked{% endif %}> {{ style.label }}</label>
                {% endfor %}
            </fieldset>
            <p class="muted">Das Selfie wird dafür mit Einwilligung des Gastes an Google (Gemini) übertragen und danach gelöscht; gespeichert wird nur die Zeichnung, sichtbar nur für den Gast selbst.{% if not portraitsAvailable %} <strong>Derzeit nicht verfügbar: Auf dem Server ist kein Gemini-Schlüssel hinterlegt.</strong>{% endif %}</p>
            <button class="button button--primary" type="submit">Module speichern</button>
        </form>
    </section>

    <section class="card" aria-labelledby="cover-title">
        <h2 id="cover-title" class="headline-sm">Titelbild der Startseite</h2>
        <p class="muted">Welches Bild Gäste oben auf der Startseite sehen. Ein festes Bild, z. B. von euch beiden, bleibt dauerhaft stehen.</p>
        <form method="post" action="{{ path('admin_settings_cover', {slug: wedding.slug}) }}" enctype="multipart/form-data" class="stack">
            {{ include('admin/_csrf.html.twig') }}
            <fieldset class="choice-group choice-group--stacked">
                <legend>Bild oben</legend>
                {% for m in coverModes %}
                    <label class="choice"><input type="radio" name="cover_mode" value="{{ m.value }}"{% if wedding.presentation.coverMode == m %} checked{% endif %}> {{ m.label }}</label>
                {% endfor %}
            </fieldset>
            <div class="field"><label>Festes Bild{% if wedding.presentation.coverPhotoAt %} ersetzen{% endif %}<input type="file" name="cover_photo" accept="image/jpeg,image/png,image/webp"></label></div>
            {% if wedding.presentation.coverPhotoAt %}
                <div class="button-row">
                    <img src="{{ path('admin_wedding_picture', {slug: wedding.slug, kind: 'titelbild', v: wedding.presentation.coverPhotoAt|date('U')}) }}" alt="Aktuelles Titelbild" height="72" style="border-radius: 8px">
                    <label class="toggle"><input type="checkbox" name="cover_photo_entfernen"> Bild entfernen</label>
                </div>
            {% endif %}
            <button class="button button--primary" type="submit">Titelbild speichern</button>
        </form>
    </section>

    <section class="card" aria-labelledby="look-title">
        <h2 id="look-title" class="headline-sm">Foto-Look</h2>
        <p class="muted">Ein gemeinsamer Look für alle Fotos und Videos – so passen Handyfotos besser zusammen. Nur in der Anzeige: Originale, Downloads und Export bleiben unverändert.</p>
        <form method="post" action="{{ path('admin_settings_look', {slug: wedding.slug}) }}" class="stack">
            {{ include('admin/_csrf.html.twig') }}
            {% set sample = lookSample and lookSample.ready and is_granted('MEDIA_VIEW', lookSample) ? media_url(lookSample, 'image/thumb') : null %}
            <fieldset class="look-pick">
                <legend class="visually-hidden">Look</legend>
                {% for look in photoLooks %}
                    <label class="look-pick__option look-{{ look.value }}">
                        <input class="visually-hidden" type="radio" name="photo_look" value="{{ look.value }}"{% if wedding.presentation.photoLook == look %} checked{% endif %}>
                        {% if sample %}<img src="{{ sample }}" alt="" width="120" height="120" loading="lazy">{% endif %}
                        <span>{{ look.label }}</span>
                    </label>
                {% endfor %}
            </fieldset>
            <button class="button button--primary" type="submit">Foto-Look speichern</button>
        </form>
    </section>

    <section class="card" aria-labelledby="nudge-title">
        <h2 id="nudge-title" class="headline-sm">Hinweis „Zu viel am Handy?“</h2>
        <p class="muted">Wer lange in der App hängt oder sehr viel hochlädt, sieht unten links eine kleine Figur, die aufs Handy starrt. Wer sie antippt, liest: „Ja, die Seite hier ist mega cool, ich weiß. Aber vergiss nicht, auch die Feier zu genießen …“. Danach verschwindet sie und taucht frühestens nach einer Stunde wieder auf. Die Zeit misst nur das Handy des Gastes; an den Server geht dabei nichts.</p>
        <form method="post" action="{{ path('admin_settings_nudge', {slug: wedding.slug}) }}" class="stack">
            {{ include('admin/_csrf.html.twig') }}
            <fieldset class="choice-group choice-group--stacked">
                <legend>Figur zeigen</legend>
                {% for m in nudgeModes %}
                    <label class="choice"><input type="radio" name="nudge_mode" value="{{ m.value }}"{% if wedding.presentation.nudgeMode == m %} checked{% endif %}> {{ m.label }}</label>
                {% endfor %}
            </fieldset>
            <div class="field"><label>Minuten bzw. Beiträge<input name="nudge_threshold" type="number" min="0" max="600" value="{{ wedding.presentation.nudgeThreshold ?: '' }}" placeholder="20 Minuten bzw. 10 Beiträge"></label></div>
            <button class="button button--primary" type="submit">Handy-Hinweis speichern</button>
        </form>
    </section>

    <section class="card" aria-labelledby="host-title">
        <h2 id="host-title" class="headline-sm">Wo liegen die Fotos? (Hinweis für Gäste)</h2>
        <p class="muted">Gäste sehen beim Beitritt, beim Hochladen und auf der Startseite, dass ihre Fotos auf einem privaten Server liegen. Mit Name und Foto der Person, die ihn betreibt, wirkt das gleich vertrauter. Ihr Foto ist für alle mit dem Hochzeitslink sichtbar, das Foto des Servers nur für Gäste.</p>
        <form method="post" action="{{ path('admin_settings_host', {slug: wedding.slug}) }}" enctype="multipart/form-data" class="stack">
            {{ include('admin/_csrf.html.twig') }}
            <div class="form-grid">
                <div class="field"><label>Name<input name="host_name" maxlength="60" value="{{ wedding.presentation.hostName }}" placeholder="z. B. Wolfgang"></label></div>
                <div class="field"><label>Ansprache
                    <select name="host_pronoun">
                        <option value=""{% if not wedding.presentation.hostPronoun %} selected{% endif %}>neutral („Sprich die Person an“)</option>
                        {% for p in pronouns %}<option value="{{ p.value }}"{% if wedding.presentation.hostPronoun == p %} selected{% endif %}>{{ p.value }} („Sprich {{ p.accusative }} an“)</option>{% endfor %}
                    </select></label></div>
            </div>
            <div class="field"><label>Kurzer Satz (optional)<input name="host_note" maxlength="160" value="{{ wedding.presentation.hostNote }}" placeholder="z. B. Trauzeuge, sitzt an Tisch 3"></label></div>
            <div class="field"><label>Foto (optional)<input type="file" name="host_photo" accept="image/jpeg,image/png,image/webp"></label></div>
            {% if wedding.presentation.hostPhotoAt %}
                <div class="button-row">
                    <img src="{{ path('wedding_host_photo', {slug: wedding.slug, v: wedding.presentation.hostPhotoAt|date('U')}) }}" alt="Aktuelles Foto" width="64" height="64" style="border-radius: 50%">
                    <label class="toggle"><input type="checkbox" name="host_photo_entfernen"> Foto entfernen</label>
                </div>
            {% endif %}
            <div class="field"><label>Der Server (optional)<input name="server_note" maxlength="200" value="{{ wedding.presentation.serverNote }}" placeholder="z. B. ein Lenovo ThinkCentre in seiner Wohnung in Köln-Ehrenfeld"></label></div>
            <div class="field"><label>Foto des Servers (optional)<input type="file" name="server_photo" accept="image/jpeg,image/png,image/webp"></label></div>
            {% if wedding.presentation.serverPhotoAt %}
                <div class="button-row">
                    <img src="{{ path('admin_wedding_picture', {slug: wedding.slug, kind: 'server', v: wedding.presentation.serverPhotoAt|date('U')}) }}" alt="Aktuelles Foto des Servers" height="64" style="border-radius: 8px">
                    <label class="toggle"><input type="checkbox" name="server_photo_entfernen"> Foto entfernen</label>
                </div>
            {% endif %}
            <button class="button button--primary" type="submit">Hinweis speichern</button>
        </form>
    </section>

    {% if permissions.manage_lifecycle %}
        <section class="card" aria-labelledby="lifecycle-title">
            <h2 id="lifecycle-title" class="headline-sm">Lebenszyklus</h2>
            <p class="muted">Archivieren beendet alle Beiträge, Gäste können aber weiter ansehen. Es wird nichts gelöscht.</p>
            <form method="post" action="{{ path('admin_settings_lifecycle', {slug: wedding.slug}) }}">
                {{ include('admin/_csrf.html.twig') }}
                <input type="hidden" name="action" value="{{ wedding.active ? 'archivieren' : 'reaktivieren' }}">
                <button class="button button--secondary" type="submit">{{ wedding.active ? 'Archivieren' : 'Wieder aktivieren' }}</button>
            </form>
        </section>
    {% endif %}

    {% if is_granted('ROLE_PLATFORM_ADMIN') %}
        {% set l = wedding.limits %}
        <section class="card" aria-labelledby="limits-title">
            <h2 id="limits-title" class="headline-sm">Limits (Plattform)</h2>
            <form method="post" action="{{ path('admin_settings_limits', {slug: wedding.slug}) }}" class="form-grid">
                {{ include('admin/_csrf.html.twig') }}
                <div class="field"><label for="max_video_seconds">Videolänge (s, max. {{ platformMaxVideoSeconds }})</label><input id="max_video_seconds" name="max_video_seconds" type="number" min="1" max="{{ platformMaxVideoSeconds }}" value="{{ l.maxVideoSeconds }}"></div>
                <div class="field"><label for="max_video_mb">Video (MB)</label><input id="max_video_mb" name="max_video_mb" type="number" min="1" value="{{ (l.maxVideoBytes / 1048576)|round }}"></div>
                <div class="field"><label for="max_photo_mb">Foto (MB)</label><input id="max_photo_mb" name="max_photo_mb" type="number" min="1" value="{{ (l.maxPhotoBytes / 1048576)|round }}"></div>
                <div class="field"><label for="storage_quota_gb">Speicher gesamt (GB)</label><input id="storage_quota_gb" name="storage_quota_gb" type="number" min="1" step="0.5" value="{{ l.storageQuotaBytes / 1073741824 }}"></div>
                <div class="field"><label for="guest_quota_gb">Pro Gast (GB, leer = unbegrenzt)</label><input id="guest_quota_gb" name="guest_quota_gb" type="number" min="0.1" step="0.1" value="{{ l.guestQuotaBytes is null ? '' : l.guestQuotaBytes / 1073741824 }}"></div>
                <button class="button button--primary" type="submit">Limits speichern</button>
            </form>
        </section>

        <section class="card card--danger">
            <h2 class="headline-sm">Hochzeit löschen</h2>
            <p class="muted">Löscht endgültig alle Fotos, Videos, Einträge, Exporte und Zugänge.</p>
            <a class="button button--secondary button--danger" href="{{ path('admin_wedding_delete', {slug: wedding.slug}) }}">Löschen …</a>
        </section>
    {% endif %}
{% endblock %}
