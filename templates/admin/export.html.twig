{% extends 'admin/_layout.html.twig' %}

{% block content %}
    <section class="card">
        <h2 class="headline-sm">Alle Erinnerungen herunterladen</h2>
        <p class="muted">ZIP mit den Originalen aller Fotos und Videos für Gäste und das Brautpaar sowie einer Übersicht (uebersicht.csv). Beiträge „nur für mich“, abgelehnte und gelöschte sind nicht enthalten. Der Download bleibt 7 Tage verfügbar.</p>
        <form method="post" action="{{ path('admin_export_request', {slug: wedding.slug}) }}">{{ include('admin/_csrf.html.twig') }}<button class="button button--primary" type="submit">Export erstellen</button></form>
    </section>

    {% if exports is not empty %}
        <ul class="row-list card">
            {% for e in exports %}
                <li>
                    <span><strong>{{ e.createdAt|date('d.m.Y H:i') }}</strong>
                        <span class="muted">{% if e.status.value == 'ready' %}{{ e.itemCount }} Dateien · {{ (e.bytes / 1048576)|number_format(0, ',', '.') }} MB · bis {{ e.expiresAt|date('d.m.') }}{% elseif e.status.value == 'pending' %}wird erstellt …{% else %}fehlgeschlagen{% endif %}</span></span>
                    {% if e.status.value == 'ready' %}<a class="text-link" href="{{ path('admin_export_download', {id: e.id, filename: wedding.slug ~ '-export.zip'}) }}">Herunterladen</a>{% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
