{% extends 'guest/_layout.html.twig' %}
{% form_theme form 'form/wedora_theme.html.twig' %}

{% block title %}Dein Name – {{ wedding.title }}{% endblock %}

{% import 'components/ornament.html.twig' as deco %}

{% block content %}
    <header class="page-header page-header--motif">
        <span class="page-header__motif">{{ deco.motif('rings', 96) }}</span>
        {% include 'guest/_wedding_badge.html.twig' %}
        <h1 class="display">Willkommen!</h1>
        <p class="tagline">Schön, dass du da bist</p>
    </header>

    <section class="card" aria-labelledby="name-title">
        <h2 id="name-title" class="headline">Wer bist du?</h2>
        {{ form_start(form, {attr: {class: 'stack', novalidate: 'novalidate'}}) }}
            {{ form_row(form.displayName) }}
            <button type="submit" class="button button--primary button--block">Los geht’s</button>
        {{ form_end(form) }}
        {{ include('guest/_privacy_note.html.twig') }}
        <p class="muted">Kein Konto nötig. Dein Zugang wird nur in diesem Browser gespeichert. Gleich bekommst du ein Codewort – damit kommst du wieder rein, falls du Browserdaten löschst oder das Gerät wechselst.</p>
    </section>

    <p class="spaced center"><a class="text-link" href="{{ path('guest_recover', {slug: wedding.slug}) }}">Ich war schon dabei und habe ein Codewort</a></p>
{% endblock %}
