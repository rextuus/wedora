{% extends 'guest/_layout.html.twig' %}
{% form_theme form 'form/wedora_theme.html.twig' %}

{% block title %}Willkommen – {{ wedding.title }}{% endblock %}

{% block content %}
    <header class="page-header">
        {% include 'guest/_wedding_badge.html.twig' %}
        <h1 class="display">Willkommen!</h1>
        <p class="tagline">Schön, dass du da bist</p>
    </header>

    <section class="card" aria-labelledby="password-title">
        <h2 id="password-title" class="headline">Fast geschafft</h2>
        <p class="lead">Bitte gib das Passwort der Hochzeit ein.</p>
        {% if error %}<p class="alert" role="alert">{{ error }}</p>{% endif %}
        {{ form_start(form, {attr: {class: 'stack', novalidate: 'novalidate'}}) }}
            {{ form_row(form.password) }}
            <button type="submit" class="button button--primary button--block">Weiter</button>
        {{ form_end(form) }}
    </section>

    <p class="muted center">Keine App-Installation nötig • Fotos werden sicher im privaten Gästebuch gespeichert</p>
{% endblock %}
