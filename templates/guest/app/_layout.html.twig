{% extends 'base.html.twig' %}
{% import 'components/icon.html.twig' as ui %}

{#
  Gast-App: Kopfzeile mit Brautpaar + Bereich, Inhalt, Navigationsleiste unten (Daumenzone).
  Erwartet: wedding, guest, section (Name des aktiven Bereichs).
#}
{% block head %}
    {# Als App auf dem Startbildschirm (Manifest ohne Gastdaten). #}
    <link rel="manifest" href="{{ path('guest_app_manifest', {slug: wedding.slug}) }}">
    <link rel="apple-touch-icon" href="{{ asset('images/apple-touch-icon.png') }}">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="{{ wedding.title }}">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
{% endblock %}

{# Gemeinsamer Foto-Look der Hochzeit (Einstellungen), wirkt auch im Vollbild, das an <body> hängt. #}
{% block body_attributes %} class="look-{{ wedding.presentation.photoLook.value }}"{% endblock %}

{% block body %}
    {% set slug = wedding.slug %}
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    <header class="app-header">
        <a class="app-header__brand" href="{{ path('guest_home', {slug: slug}) }}">
            <span class="app-header__title">{{ wedding.title }}</span>
            <span class="app-header__section">{% block section %}{% endblock %}</span>
        </a>
        <a class="app-header__avatar" href="{{ path('guest_album', {slug: slug}) }}" aria-label="Mein Album">{{ guest.displayName|first|upper }}</a>
    </header>

    {% set nudge = nudge_settings(guest) %}
    <main class="{% block main_class %}app-main{% endblock %}" id="main"
          data-controller="nudge" data-nudge-mode-value="{{ nudge.mode }}" data-nudge-threshold-value="{{ nudge.threshold }}"
          data-nudge-recent-value="{{ nudge.recent }}" data-nudge-key-value="wedora-nudge-{{ guest.id }}">
        {% for type, messages in app.flashes %}
            {% for message in messages %}<p class="notice notice--{{ type }}" role="status">{{ message }}</p>{% endfor %}
        {% endfor %}
        {% block content %}{% endblock %}
        {{ include('guest/app/_nudge_dialog.html.twig') }}
    </main>

    {% set nav = [
        {route: 'guest_home', label: 'Start', icon: 'home', key: 'home'},
        {route: 'guest_gallery', label: 'Galerie', icon: 'photos', key: 'gallery'},
    ] %}
    {% if wedding.module(enum('App\\Wedding\\ModuleType').Challenges).enabled %}
        {% set nav = nav|merge([{route: 'guest_challenges', label: 'Aufgaben', icon: 'sparkle', key: 'challenges'}]) %}
    {% endif %}
    {% if wedding.module(enum('App\\Wedding\\ModuleType').Guestbook).enabled %}
        {% set nav = nav|merge([{route: 'guest_guestbook', label: 'Gästebuch', icon: 'book', key: 'guestbook'}]) %}
    {% endif %}
    {% set nav = nav|merge([{route: 'guest_album', label: 'Mein Album', icon: 'album', key: 'album'}]) %}

    <nav class="bottom-nav" aria-label="Hauptnavigation">
        {% for item in nav %}
            <a href="{{ path(item.route, {slug: slug}) }}" class="bottom-nav__item"{% if active|default('') == item.key %} aria-current="page"{% endif %}>
                {{ ui.icon(item.icon) }}<span>{{ item.label }}</span>
            </a>
        {% endfor %}
    </nav>
{% endblock %}
