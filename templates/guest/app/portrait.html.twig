{% extends 'guest/app/_layout.html.twig' %}
{% import 'components/icon.html.twig' as ui %}
{% import 'components/ornament.html.twig' as deco %}

{% block title %}Dein Porträt – {{ wedding.title }}{% endblock %}
{% block section %}Porträt{% endblock %}

{% block content %}
    <header class="section-header section-header--motif portrait-header">
        <span class="section-header__motif">{{ deco.motif('pencil', 92) }}</span>
        <p class="overline">{{ welcome ? 'Willkommen, ' ~ guest.displayName : 'Dein Porträt' }}</p>
        <h1 class="headline-lg">Lass dich <em>zeichnen</em></h1>
        <p class="lead">Mach ein Selfie oder nimm ein Foto von dir – daraus entsteht {{ wedding.letsGuestsChoosePortraitStyle() ? 'ein gezeichnetes Porträt im Stil deiner Wahl' : (wedding.portraitStyles()|length > 1 ? 'ein gezeichnetes Porträt' : 'eine feine Linienzeichnung im Stil dieser Hochzeit') }}. Erst einmal siehst nur du es – auf der Gästewand zeigen kannst du es, wenn du magst.</p>
        {{ deco.sprig(110) }}
    </header>

    {% if error %}<p class="notice notice--error" role="alert">{{ error }}</p>{% endif %}

    {% if guest.hasPortrait() %}
        <section class="card portrait-card" aria-label="Dein aktuelles Porträt">
            <span class="portrait__wreath portrait__wreath--large">{{ deco.garland(250) }}{{ include('guest/app/_portrait_art.html.twig') }}</span>
            {% if guest.portraitGadget %}
                <p class="badge">Überraschung: {{ guest.portraitGadget.label }}</p>
            {% endif %}
            <form class="portrait-share" method="post" action="{{ path('guest_portrait_share', {slug: wedding.slug}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('guest-action') }}">
                <input type="hidden" name="shared" value="{{ guest.portraitShared ? 0 : 1 }}">
                {% if guest.portraitShared %}
                    <p class="muted">{{ ui.icon('check', 16) }} Auf der <a href="{{ path('guest_wall', {slug: wedding.slug}) }}">Gästewand</a> – sichtbar für Gäste, die ihr Porträt auch zeigen.</p>
                    <button class="link-button" type="submit">Nicht mehr zeigen</button>
                {% else %}
                    <p class="muted">Zeig dein Porträt auf der Gästewand „Wer ist alles da?“ und sieh die der anderen. Es erscheint dann auch klein neben deinen Fotos und Gästebuch-Einträgen – nur für Gäste, die ihres auch zeigen, nicht für das Brautpaar.</p>
                    <button class="button button--primary" type="submit">Auf der Gästewand zeigen</button>
                {% endif %}
            </form>
            <div class="button-row">
                <a class="button button--secondary" href="{{ path('guest_portrait_image', {slug: wedding.slug, v: guest.portraitUpdatedAt|date('U'), download: 1}) }}" download>{{ ui.icon('download', 18) }} Herunterladen</a>
                <form method="post" action="{{ path('guest_portrait_delete', {slug: wedding.slug}) }}" data-turbo-confirm="Porträt löschen?">
                    <input type="hidden" name="_token" value="{{ csrf_token('guest-action') }}">
                    <button class="button button--secondary" type="submit">{{ ui.icon('trash', 18) }} Löschen</button>
                </form>
            </div>
        </section>
    {% endif %}

    {% if exhausted|default(false) %}
        <p class="notice" role="status">Das Zeichnen ist für heute leider ausgeschöpft. Schau morgen wieder vorbei!</p>
    {% elseif guest.portraitStatus and guest.portraitStatus.value == 'pending' %}
        <p class="notice" role="status">Dein Porträt wird gerade gezeichnet. Das dauert meist unter einer Minute.</p>
    {% else %}
        <form class="card stack" method="post" action="{{ path('guest_portrait_create', {slug: wedding.slug}) }}" enctype="multipart/form-data"
              data-controller="selfie" data-action="submit->selfie#prepare">
            <input type="hidden" name="_token" value="{{ csrf_token('guest-action') }}">
            <input type="hidden" name="welcome" value="{{ welcome ? 1 : 0 }}">
            <h2 class="headline-sm">{{ guest.hasPortrait() ? 'Neues Porträt' : 'Dein Foto' }}</h2>

            {# Ohne capture bietet das Handy Kamera und Fotomediathek an; die Knöpfe darunter gehen direkt zu einem davon. #}
            <label class="selfie-pick">
                <input class="visually-hidden" type="file" name="selfie" accept="image/*" data-selfie-target="input" data-action="change->selfie#preview">
                <img class="selfie-pick__preview" alt="" hidden data-selfie-target="preview">
                <span class="selfie-pick__empty" data-selfie-target="placeholder">{{ ui.icon('camera', 28) }} Selfie oder Foto von dir</span>
            </label>
            <div class="selfie-sources" hidden data-selfie-target="sources">
                <button class="button button--secondary" type="button" data-action="selfie#camera">{{ ui.icon('camera', 18) }} Selfie aufnehmen</button>
                <button class="button button--secondary" type="button" data-action="selfie#library">{{ ui.icon('photos', 18) }} Foto auswählen</button>
            </div>
            <p class="muted center">Am besten ein Foto, auf dem nur du gut zu sehen bist.</p>

            {% set styles = wedding.portraitStyles() %}
            {% if wedding.letsGuestsChoosePortraitStyle() %}
                <fieldset class="style-pick">
                    <legend>Welcher Stil?</legend>
                    {% for style in styles %}
                        <label class="style-pick__option">
                            <input class="visually-hidden" type="radio" name="style" value="{{ style.value }}"{% if loop.first %} checked{% endif %}>
                            <img src="{{ asset('images/portrait-styles/' ~ style.value ~ '.jpg') }}" alt="" width="120" height="120" loading="lazy">
                            <span>{{ style.label }}</span>
                        </label>
                    {% endfor %}
                </fieldset>
            {% elseif styles|length > 1 %}
                <p class="muted">Welcher Stil es wird, ist eine Überraschung.</p>
            {% endif %}

            {% if question %}
                <fieldset class="choice-group portrait-question">
                    <legend>Kurze Frage: {{ question.question }}</legend>
                    <input type="hidden" name="question" value="{{ question.key }}">
                    {% for key, answer in question.answers %}
                        <label class="choice"><input type="radio" name="answer" value="{{ key }}" required> {{ answer.label }}</label>
                    {% endfor %}
                </fieldset>
            {% endif %}

            <label class="consent">
                <input type="checkbox" name="consent" value="1" required>
                <span>Ich bin einverstanden, dass mein Foto zum Zeichnen an Google (Gemini) übertragen wird. Das Foto wird danach sofort gelöscht, gespeichert bleibt nur die Zeichnung – und die kann ich jederzeit löschen.</span>
            </label>

            <button class="button button--primary" type="submit" data-selfie-target="submit">{{ ui.icon('check', 18) }} Zeichnen lassen</button>
        </form>
    {% endif %}

    <p class="spaced"><a class="text-link" href="{{ path('guest_home', {slug: wedding.slug}) }}">{{ welcome ? 'Überspringen' : 'Zurück zur Startseite' }} {{ ui.icon('next', 14) }}</a></p>
{% endblock %}
