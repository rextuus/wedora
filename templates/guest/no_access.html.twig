{% extends 'guest/_layout.html.twig' %}

{% block title %}Zugang über Einladung{% endblock %}

{% import 'components/ornament.html.twig' as deco %}

{% block content %}
    <header class="page-header page-header--motif">
        <span class="page-header__motif">{{ deco.motif('envelope', 96) }}</span>
        <h1 class="display">Schön, dass du hier bist</h1>
        <p class="tagline">Der Zugang erfolgt über eure Einladung</p>
    </header>

    <section class="card">
        <p class="lead">Bitte scanne den QR-Code vor Ort oder öffne deinen persönlichen Einladungslink.</p>
        <p class="muted">Wenn du schon dabei warst: Dein Zugang ist an diesen Browser gebunden. Nach dem Löschen von Browserdaten oder auf einem anderen Gerät brauchst du den Link erneut.</p>
    </section>
{% endblock %}
