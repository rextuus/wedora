<!DOCTYPE html>
<html lang="de">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <meta name="theme-color" content="#fbf9f6">
        <meta name="robots" content="noindex, nofollow">
        <title>{% block title %}Wedora{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22><circle cx=%2232%22 cy=%2232%22 r=%2230%22 fill=%22%2348584a%22/><text x=%2232%22 y=%2242%22 font-size=%2228%22 text-anchor=%22middle%22 fill=%22%23fbf9f6%22 font-family=%22serif%22>W</text></svg>">
        {% block head %}{% endblock %}
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
