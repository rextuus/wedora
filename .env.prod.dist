# Wedora – Produktions-Secrets. Vorlage; auf dem Server nach .env.prod.local kopieren
# (oder `make prod-secrets` ausführen) und ausfüllen. .env.prod.local nie ins Repository.

# Öffentliche Adresse – Caddy holt dafür automatisch ein HTTPS-Zertifikat (Let's Encrypt).
SERVER_NAME=wedora.example.de
DEFAULT_URI=https://wedora.example.de

APP_SECRET=
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
IMGPROXY_KEY=
IMGPROXY_SALT=
MEDIA_TOKEN_SECRET=

# Optional: gezeichnete Gästeporträts (leer = Funktion aus).
GEMINI_API_KEY=

# Nur zum Testen auf anderen Ports (Standard 80/443).
HTTP_PORT=80
HTTPS_PORT=443
