# Wedora – Produktions-Secrets. Vorlage; auf dem Server nach .env.prod.local kopieren
# (oder `make prod-secrets` ausführen) und ausfüllen. .env.prod.local nie ins Repository.

# Öffentliche Adresse (steckt in QR-Codes und Einladungen). HTTPS macht der Caddy auf dem VPS.
DEFAULT_URI=https://wedora.example.de

APP_SECRET=
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
IMGPROXY_KEY=
IMGPROXY_SALT=
MEDIA_TOKEN_SECRET=

# Optional: gezeichnete Gästeporträts (leer = Funktion aus).
GEMINI_API_KEY=
# Kostenbremse: höchstens so viele Bilder pro Tag / Monat über alle Hochzeiten (0 = Zeichnen aus).
GEMINI_DAILY_LIMIT=50
GEMINI_MONTHLY_LIMIT=300

# Hinter dem Reverse-Proxy (VPS-Caddy über WireGuard), siehe docs/deployment.md:
# Port, auf dem dieser Rechner Wedora per HTTP anbietet (auf dem ThinkCentre frei: 8190).
HTTP_PORT=8190
# Nur auf dieser Adresse lauschen – am besten die WireGuard-IP dieses Rechners (z. B. 10.8.0.2); 0.0.0.0 = überall.
HTTP_BIND=0.0.0.0
# Vom wem X-Forwarded-For/-Proto übernommen werden: die WireGuard-IP des VPS (z. B. 10.8.0.1).
REVERSE_PROXY_IPS=private_ranges
